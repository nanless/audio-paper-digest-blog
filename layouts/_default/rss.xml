{{- $dailyPages := slice }}
{{- range where site.RegularPages "Section" "posts" }}
  {{- $baseName := "" }}
  {{- with .File }}{{ $baseName = .BaseFileName }}{{ end }}
  {{- $isDateIndex := gt (len (findRE `^\d{4}-\d{2}-\d{2}$` $baseName 1)) 0 }}
  {{- if $isDateIndex }}
    {{- $dailyPages = $dailyPages | append . }}
  {{- end }}
{{- end }}
{{- $pages := first 50 (sort $dailyPages "Date" "desc") }}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?\u003e" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.Title }}</title>
    <link>{{ site.Home.Permalink }}</link>
    <description>{{ site.Params.description | default site.Title }}</description>
    <language>{{ site.Language.LanguageCode }}</language>
    {{- with site.Home.OutputFormats.Get "RSS" }}
    <atom:link href="{{ .Permalink }}" rel="self" type="{{ .MediaType.Type }}" />
    {{- end }}
    {{- if gt (len $pages) 0 }}
    <lastBuildDate>{{ (index $pages 0).Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    {{- end }}
    {{- range $pages }}
    {{- $summary := .Summary | plainify | htmlUnescape | strings.TrimSpace | truncate 480 }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <description>{{ $summary }}</description>
      {{- range .GetTerms "tags" }}
      <category>{{ .LinkTitle }}</category>
      {{- end }}
    </item>
    {{- end }}
  </channel>
</rss>
