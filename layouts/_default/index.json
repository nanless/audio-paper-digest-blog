{{- /* Concept names and ancestry are resolved from the shared registry once by
       each search client, rather than copied into every paper index entry. */ -}}
{{- $.Scratch.Set "searchIndex" slice -}}
{{- range site.RegularPages -}}
  {{- if and (not .Params.searchHidden) (ne .Layout `archives`) (ne .Layout `search`) (ne .Layout `library`) }}
    {{- $metadata := partial "research_metadata.html" . }}
    {{- $taxonomyProof := partial "taxonomy_page_proof.html" . }}

    {{- $description := .Description | default "" | plainify | htmlUnescape | strings.TrimSpace }}
    {{- $score := $metadata.score }}
    {{- $summary := $description }}
    {{- if or (not $summary) (and $score (lt (len $summary) 48)) }}
      {{- $summary = .Summary | plainify | htmlUnescape | strings.TrimSpace }}
    {{- end }}
    {{- $summary = ($metadata.oneSentence | default $summary) | plainify | htmlUnescape | truncate 320 }}

    {{- $tags := .Params.tags | default slice }}
    {{- $categories := .Params.categories | default slice }}

    {{- /* Names, aliases and ancestry live once in the registry. Keep the index
          backward compatible, but omit repeated original titles and empty fields. */}}
    {{- $entry := dict
      "title" .Title
      "titleZh" ($metadata.headline | plainify)
      "permalink" .RelPermalink
      "summary" $summary
      "date" (.Date.Format "2006-01-02")
      "pageType" $metadata.pageType
      "task" $metadata.task
      "method" $metadata.method
      "score" $score
      "arxivId" $metadata.arxivId
      "tags" $tags
      "categories" $categories
      "taxonomyContract" ($taxonomyProof.contract | default "")
      "taxonomyConcepts" ($taxonomyProof.concepts | default slice)
      "citation" (partial "citation_source.html" .)
    }}
    {{- if eq ($metadata.taxonomyPublicationStatus | default "") "withheld" }}{{ $entry = merge $entry (dict "taxonomyPublicationStatus" "withheld" "tags" slice) }}{{ end }}
    {{- with $taxonomyProof.registrySha256 }}{{ $entry = merge $entry (dict "taxonomyRegistrySha256" .) }}{{ end }}
    {{- with $taxonomyProof.evidenceContract }}{{ $entry = merge $entry (dict "taxonomyEvidenceContract" . "taxonomyEvidenceType" ($taxonomyProof.evidenceType | default "canonical-analysis") "taxonomyProofSha256" $taxonomyProof.proofSha256 "taxonomyPageSha256" $taxonomyProof.pageSha256) }}{{ end }}
    {{- if in (slice "historical-source-taxonomy-classification-v2" "historical-source-taxonomy-classification-v3" "exact1028-independent-review-qualified-classification-v1") $taxonomyProof.classificationContract }}
      {{- $entry = merge $entry (dict "taxonomyClassificationContract" $taxonomyProof.classificationContract) }}
      {{- range $key := slice "researchType" "domainScope" "primaryResearchRole" "primaryScientificTopicId" "primaryScientificTopicLabel" "methodNotApplicable" "methodNotApplicableReason" }}{{ $entry = merge $entry (dict $key (index $metadata $key)) }}{{ end }}
    {{- end }}
    {{- if ne $metadata.originalTitle .Title }}{{ $entry = merge $entry (dict "originalTitle" $metadata.originalTitle) }}{{ end }}
    {{- range $key := slice "paperId" "sourceKind" "primaryTaskId" "primaryMethodId" "identityEvidenceContract" "identityEvidenceType" "identityProofSha256" "identityPageSha256" }}
      {{- with index $metadata $key }}{{ $entry = merge $entry (dict $key .) }}{{ end }}
    {{- end }}
    {{- if eq $metadata.pageType "paper" }}{{ $entry = merge $entry (dict "identityStatus" $metadata.identityStatus) }}{{ end }}
    {{- $.Scratch.Add "searchIndex" (slice $entry) }}
  {{- end }}
{{- end }}
{{- $.Scratch.Get "searchIndex" | jsonify -}}
